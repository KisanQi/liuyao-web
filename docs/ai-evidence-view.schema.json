{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.liuyao.example/schemas/ai-evidence-view-1.1.json",
  "title": "Liuyao AI Evidence View",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCase",
    "question",
    "questionAssessment",
    "rulebook",
    "facts",
    "analysis",
    "constraints"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "sourceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultId", "inputHash", "readingSchemaVersion", "rulesetVersion", "engine", "engineVersion"],
      "properties": {
        "resultId": { "type": "string", "minLength": 1 },
        "inputHash": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "readingSchemaVersion": { "const": "2.2" },
        "rulesetVersion": { "const": "jingfang-zengshan-v1" },
        "engine": { "const": "mingyu-core" },
        "engineVersion": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "required": ["text", "topic"],
      "properties": {
        "text": { "type": "string" },
        "topic": { "enum": ["general", "shiye", "caifu", "ganqing"] },
        "topicSource": { "enum": ["user", "inferred", "fallback"] },
        "topicReason": { "type": "string" },
        "timeframe": { "type": "string" },
        "background": { "type": "string" },
        "usefulGodRelative": { "enum": ["父母", "兄弟", "子孙", "妻财", "官鬼"] }
      }
    },
    "questionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "canAnalyze", "issues"],
      "properties": {
        "status": { "enum": ["完整", "缺少具体问题", "缺少现实期限", "缺少具体问题和现实期限"] },
        "canAnalyze": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rulebook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rules"],
      "properties": {
        "version": { "const": "jingfang-zengshan-ai-guide-v1" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "principle", "scope", "sources"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "principle": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart", "timing", "lines", "hiddenSpirits", "lineFacts", "hiddenSpiritFacts", "structureFacts"],
      "properties": {
        "chart": { "type": "object" },
        "timing": { "type": "object" },
        "lines": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "object" } },
        "hiddenSpirits": { "type": "array", "items": { "type": "object" } },
        "lineFacts": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/fact" } },
        "hiddenSpiritFacts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "structureFacts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceStatus", "overview", "focusCandidates", "counterEvidence", "timingFacts", "limitations", "limitationFacts"],
      "properties": {
        "evidenceStatus": { "type": "string" },
        "overview": { "type": "object" },
        "focusCandidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "counterEvidence": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "timingFacts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "limitationFacts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mustNotRecalculateChart", "mustCiteFactKeys", "mustPresentCounterEvidence", "prohibitedOutputs"],
      "properties": {
        "mustNotRecalculateChart": { "const": true },
        "mustCiteFactKeys": { "const": true },
        "mustPresentCounterEvidence": { "const": true },
        "prohibitedOutputs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["key", "type", "text", "sources", "limitation", "ownerFactKeys", "referenceKeys"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "limitation": { "type": "string" },
        "ownerFactKeys": { "type": "array", "items": { "type": "string" } },
        "referenceKeys": { "type": "array", "items": { "type": "string" } },
        "ownerCandidateKey": { "type": "string" },
        "sourceStatus": { "type": "string" }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["key", "label", "status", "references", "referenceKeys", "ownerFactKeys", "support", "constraints", "sources", "limitation"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "status": { "type": "string" },
        "references": { "type": "array", "items": { "type": "object" } },
        "referenceKeys": { "type": "array", "items": { "type": "string" } },
        "ownerFactKeys": { "type": "array", "items": { "type": "string" } },
        "support": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } },
        "limitation": { "type": "string" }
      }
    }
  }
}
